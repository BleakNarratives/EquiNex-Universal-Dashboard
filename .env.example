# =============================================================================
# EquiNex Universal Dashboard — Environment Configuration
# =============================================================================
#
# QUICK START:
#   1. cp .env.example .env
#   2. Add your Gemini API key (optional — app works without it)
#   3. npm install && npm run dev (frontend)
#   4. .venv/bin/uvicorn backend.main:app --port 8000 (backend)
#
# =============================================================================


# ── Gemini AI Assistant (optional) ────────────────────────────────────────────
# Powers the live AI chat interface in the dashboard.
# Without it, the app runs fully on the backend (mock data).
#
# Get key: https://aistudio.google.com/apikey
# Must start with "AIza" (not an OAuth token)

GEMINI_API_KEY=


# ── Notes ─────────────────────────────────────────────────────────────────────
#
# • Only GEMINI_API_KEY is configurable — everything else is hardcoded
# • The AI assistant panel is hidden when no key is set
# • Frontend reads this via Vite's process.env.API_KEY injection
# • Backend runs independently — no API keys needed
#
# =============================================================================
